import pandas as pd

order_data = pd.DataFrame({
    'Customer_ID': [101, 102, 101, 103, 102],
    'Order_Date': ['2026-01-05', '2026-01-10',
                   '2026-01-15', '2026-01-20', '2026-01-25'],
    'Product_Name': ['Laptop', 'Mouse', 'Laptop',
                     'Keyboard', 'Mouse'],
    'Order_Quantity': [2, 3, 1, 4, 2]
})

order_data['Order_Date'] = pd.to_datetime(order_data['Order_Date'])

print("Order Data:")
print(order_data)

print("\nOrders per Customer:")
print(order_data.groupby('Customer_ID').size())

print("\nAverage Quantity per Product:")
print(order_data.groupby('Product_Name')['Order_Quantity'].mean())

print("\nEarliest Order Date:",
      order_data['Order_Date'].min().date())

print("Latest Order Date:",
      order_data['Order_Date'].max().date())

