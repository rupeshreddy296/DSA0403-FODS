
import pandas as pd
import re
from collections import Counter
import matplotlib.pyplot as plt

# Read CSV file
df = pd.read_csv("19customer_reviews.csv")

# Remove missing reviews
reviews = df["Review Text"].dropna().astype(str)

# Combine all reviews
text = " ".join(reviews)

# Convert to lowercase
text = text.lower()

# Extract words
words = re.findall(r"\b[a-z]+\b", text)

# Calculate word frequency
word_frequency = Counter(words)

# Convert to DataFrame
result = pd.DataFrame(
    word_frequency.items(),
    columns=["Word", "Frequency"]
)

# Sort by frequency
result = result.sort_values(
    by="Frequency", ascending=False
)

# Display top 20 words
print("Top 20 Frequently Used Words:")
print(result.head(20))

# Save output
result.to_csv("customer_review_word_frequency.csv", index=False)

# Plot top 20 words
top_words = result.head(20)

plt.figure(figsize=(12, 6))
plt.bar(top_words["Word"], top_words["Frequency"])

plt.title("Word Frequency Distribution of Customer Reviews")
plt.xlabel("Words")
plt.ylabel("Frequency")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()


