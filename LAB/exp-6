
# Item prices and quantities
prices = [100, 200, 150, 50]
quantities = [2, 1, 3, 4]

# Discount and tax rates
discount_rate = 10
tax_rate = 5

# Calculate subtotal
subtotal = 0
for i in range(len(prices)):
    subtotal += prices[i] * quantities[i]

# Calculate discount
discount = subtotal * discount_rate / 100

# Calculate discounted amount
discounted_amount = subtotal - discount

# Calculate tax
tax = discounted_amount * tax_rate / 100

# Calculate final total
total_cost = discounted_amount + tax

# Display results
print("Subtotal: Rs.", round(subtotal, 2))
print("Discount: Rs.", round(discount, 2))
print("Amount after discount: Rs.", round(discounted_amount, 2))
print("Tax: Rs.", round(tax, 2))
print("Total cost: Rs.", round(total_cost, 2))

Output:
