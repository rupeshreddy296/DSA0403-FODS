import matplotlib.pyplot as plt
import pandas as pd


file_path = "Exp10.xlsx"
df = pd.read_excel(file_path)


df["order_date"] = pd.to_datetime(df["order_date"])
df["month_num"] = df["order_date"].dt.month
monthly_sales = df.groupby("month_num")["sales"].sum()

month_labels = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
]
months = [month_labels[i - 1] for i in monthly_sales.index]
sales = monthly_sales.values

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))

ax1.plot(
    months,
    sales,
    marker="o",
    color="#1f77b4",
    linewidth=2,
    markersize=6,
    label="Sales Trend",
)
ax1.set_title(
    "Monthly Sales Trend (Line Plot)", fontsize=14, fontweight="bold", pad=12
)
ax1.set_xlabel("Month", fontsize=12)
ax1.set_ylabel("Total Sales ($)", fontsize=12)
ax1.grid(True, linestyle="--", alpha=0.6)
ax1.legend(loc="upper left")

bars = ax2.bar(months, sales, color="#4169E1", edgecolor="black", width=0.6)
ax2.set_title(
    "Monthly Sales Distribution (Bar Plot)",
    fontsize=14,
    fontweight="bold",
    pad=12,
)
ax2.set_xlabel("Month", fontsize=12)
ax2.set_ylabel("Total Sales ($)", fontsize=12)
ax2.grid(axis="y", linestyle="--", alpha=0.6)

for bar in bars:
    height = bar.get_height()
    ax2.text(
        bar.get_x() + bar.get_width() / 2.0,
        height + 15000,
        f"${height/1e3:.0f}K",
        ha="center",
        va="bottom",
        fontsize=8,
    )

plt.tight_layout()
plt.savefig("monthly_sales_visualization.png", dpi=300)
plt.show()
