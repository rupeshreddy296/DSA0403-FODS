import pandas as pd
import urllib.request
import re
import numpy as np

# Step 1: Extract URL from Exp10.csvCSV.url
url_file_path = "/content/Exp10.csvCSV.url"
output_csv = "/content/Exp10_actual.csv"
sales_df = None

try:
    with open(url_file_path, "r") as f:
        content = f.read()

    match = re.search(r"URL=(https://[\w\d./?=&-]+)", content)
    if match:
        drive_url = match.group(1)
        file_id_match = re.search(r"/d/([\w_-]+)", drive_url)
        if file_id_match:
            file_id = file_id_match.group(1)
            url = f"https://drive.google.com/uc?id={file_id}&export=download"
            req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
            
            with urllib.request.urlopen(req) as response:
                res_content = response.read()
            
            html_content = res_content.decode('utf-8', errors='ignore')
            if "signin" in html_content or "accounts.google.com" in html_content:
                print("Google Drive file is restricted to logged-in users. Using fallback sales dataset.")
                raise PermissionError("Access restricted.")
                
            with open(output_csv, 'wb') as f:
                f.write(res_content)
            sales_df = pd.read_csv(output_csv)
            print("Dataset downloaded successfully.")
except Exception as e:
    print(f"Could not load dataset from link: {e}")

# Fallback dataset matching the scenario specs if download fails
if sales_df is None:
    print("Creating fallback monthly sales dataset.")
    months = ['January', 'February', 'March', 'April', 'May', 'June', 
              'July', 'August', 'September', 'October', 'November', 'December']
    sales_values = [12000, 15000, 14000, 18200, 22000, 21000, 
                    24500, 23000, 28000, 31000, 35000, 42000]
    sales_df = pd.DataFrame({
        'Month': months,
        'Sales': sales_values
    })
    sales_df.to_csv(output_csv, index=False)
    print("Fallback dataset loaded and saved as 'Exp10_actual.csv'.")

display(sales_df.head())



