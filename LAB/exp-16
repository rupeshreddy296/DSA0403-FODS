
import pandas as pd
import re
from collections import Counter

# Read CSV file
df = pd.read_csv("16bbc-text.csv")

# Extract text
text = " ".join(df["text"].dropna().astype(str))

# Convert to lowercase
text = text.lower()

# Extract words
words = re.findall(r"\b[a-z]+\b", text)

# Calculate word frequency
word_freq = Counter(words)

# Create DataFrame
result = pd.DataFrame(
    word_freq.items(),
    columns=["Word", "Frequency"]
)

# Sort by frequency
result = result.sort_values(
    by="Frequency",
    ascending=False
)

# Save output
result.to_csv("word_frequency.csv", index=False)

# Display top 20 words
print(result.head(20))

print("Word frequency distribution completed!")


