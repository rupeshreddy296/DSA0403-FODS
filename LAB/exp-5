
import numpy as np

# Sample fuel efficiency data (km/l)
fuel_efficiency = np.array([15, 18, 20, 22, 25])

# Calculate average fuel efficiency
average = np.mean(fuel_efficiency)

# Percentage improvement from first to last model
improvement = ((fuel_efficiency[-1] - fuel_efficiency[0])
               / fuel_efficiency[0]) * 100

print("Average fuel efficiency:", round(average, 2), "km/l")
print("Percentage improvement:", round(improvement, 2), "%")

Output:
Average fuel efficiency: 20.0 km/l
Percentage improvement: 66.67 %
