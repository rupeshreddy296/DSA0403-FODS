
import pandas as pd
import numpy as np

# Read the dataset
df = pd.read_excel("Exp9.xlsx")

# Convert bedrooms and price into a NumPy array
house_data = df[['bedrooms', 'price']].to_numpy()

# Select houses with more than 4 bedrooms
selected_houses = house_data[house_data[:, 0] > 4]

# Calculate average sale price
average_price = np.mean(selected_houses[:, 1])

print("Houses with more than 4 bedrooms:")
print(selected_houses)

print("Average Sale Price:", round(average_price, 2))

