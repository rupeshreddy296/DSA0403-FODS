import numpy as np

sales_matrix = np.array([
    [18, 267.22, 4809.96],  # Product 1
    [17, 4209.44, 71560.48], # Product 2
    [30, 371.40, 11142.00]   # Product 3
])

prices = sales_matrix[:, 1]

average_price = np.mean(prices)

print("Prices of products:", prices)
print(f"Average price of all products: ${average_price:.2f}")

