
import numpy as np
import pandas as pd

# Read the Excel dataset
df = pd.read_excel("Sales (1).xlsx")

# Display the dataset
print("Sales Data:")
print(df.head())

# Select the first 3 rows and 3 numeric columns
data = df.select_dtypes(include="number").iloc[:3, :3]

# Convert to NumPy array
sales_data = data.to_numpy()

print("\n3x3 NumPy Matrix:")
print(sales_data)

# Calculate average
average = np.mean(sales_data)

print("\nAverage price of all products:", round(average, 2))

